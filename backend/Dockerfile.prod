FROM python:3.13-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential gcc git \
    && apt-get clean && find /var/lib/apt/lists -type f -delete

# Runtime dependencies only
COPY requirements.txt .
RUN pip install -r requirements.txt

# Production stage
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ENVIRONMENT=production

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl git \
    && apt-get clean && find /var/lib/apt/lists -type f -delete

COPY --from=builder /usr/local/lib/python3.13/site-packages /usr/local/lib/python3.13/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

WORKDIR /app

COPY app/ ./app/
COPY codesage_mcp/ ./codesage_mcp/
COPY alembic/ ./alembic/
COPY alembic.ini .

# Non-root user, then the SQLite dir writable by it. Named volumes
# mounted here inherit this ownership on first creation.
RUN adduser --disabled-password --gecos '' --uid 1000 appuser
RUN mkdir -p /app/data \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8001/health || exit 1

# Single worker: WebSocket, rate-limit and job state are in-process and SQLite is
# single-writer. Do not raise --workers without moving that state out of process.
# Forwarded headers are trusted from any peer because only nginx can reach this port
# (no published ports) and it overwrites X-Forwarded-For; rate limits key on that client IP.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1", "--forwarded-allow-ips", "*"]
