# Production nginx server, rendered by the nginx image's envsubst step
# (/etc/nginx/templates -> /etc/nginx/conf.d). Only ${CODESAGE_API_KEY} is
# substituted; nginx's own $variables are left alone.
#
# The browser never sees the API key: visitors sign in with basic auth
# (deployment/htpasswd), and nginx adds X-API-Key to every /api and /ws request.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream codesage_backend {
    server backend:8001;
}

server {
    listen 80;
    server_name _;  # Replace with your domain
    client_max_body_size 2M;

    gzip on;
    gzip_proxied any;
    gzip_types text/plain text/css application/json application/javascript;

    # Basic auth over plain HTTP sends the password in clear text: enable TLS
    # before exposing this beyond a trusted network.
    auth_basic "CodeSage";
    auth_basic_user_file /etc/nginx/htpasswd;

    location /ws {
        proxy_pass http://codesage_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-API-Key "${CODESAGE_API_KEY}";
        proxy_set_header Authorization "";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/ {
        proxy_pass http://codesage_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-API-Key "${CODESAGE_API_KEY}";
        proxy_set_header Authorization "";
        proxy_read_timeout 60s;
    }

    # Open, so load balancers and uptime checks need no password
    location = /health {
        auth_basic off;
        proxy_pass http://codesage_backend;
        proxy_set_header Host $host;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri /index.html;
    }
}
