# Production nginx server, rendered by the nginx image's envsubst step
# (/etc/nginx/templates -> /etc/nginx/conf.d). Only ${CODESAGE_API_KEY} is
# substituted; nginx's own $variables are left alone.
#
# The browser never sees the API key: visitors sign in with basic auth
# (deployment/htpasswd), and nginx adds X-API-Key to every /api and /ws request.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Requests per client address on the HTTPS server. The limit runs before basic auth, so it also
# slows password guessing; a dashboard visit stays far below it
limit_req_zone $binary_remote_addr zone=codesage:10m rate=10r/s;

upstream codesage_backend {
    server backend:8001;
}

# Plain HTTP serves only /health; everything else moves to HTTPS, because basic
# auth over HTTP would send the password in clear text.
server {
    listen 80;
    server_name _;

    location = /health {
        proxy_pass http://codesage_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;  # Replace with your domain

    # Certificates are mounted from deployment/ssl (see DOCKER.md)
    ssl_certificate /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    # TLS 1.2: ECDHE (forward secrecy) with AEAD only, Mozilla's intermediate list without DHE (no
    # dhparam here). nginx's default also takes static-RSA and CBC suites, and lets the client pick them
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    add_header Strict-Transport-Security "max-age=63072000" always;
    # Server-level headers reach every location below while none sets its own add_header
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    add_header Referrer-Policy "same-origin" always;
    client_max_body_size 2M;

    gzip on;
    gzip_proxied any;
    gzip_types text/plain text/css application/json application/javascript;

    limit_req zone=codesage burst=50 nodelay;
    limit_req_status 429;

    auth_basic "CodeSage";
    auth_basic_user_file /etc/nginx/htpasswd;

    # X-Forwarded-For is overwritten, not appended: the backend trusts it for per-client
    # rate limits, so a client must not be able to choose its own address
    # Host keeps the port ($http_host, not $host): the backend compares it with the
    # browser's Origin, which includes the port when it isn't 443

    location /ws {
        proxy_pass http://codesage_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-API-Key "${CODESAGE_API_KEY}";
        proxy_set_header Authorization "";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/ {
        proxy_pass http://codesage_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-API-Key "${CODESAGE_API_KEY}";
        proxy_set_header Authorization "";
        proxy_read_timeout 60s;
    }

    # Open, so load balancers and uptime checks need no password
    location = /health {
        auth_basic off;
        proxy_pass http://codesage_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
    }

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri /index.html;
    }
}
