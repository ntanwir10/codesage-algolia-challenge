# CodeSage environment configuration template.
# 'make setup' copies this to backend/.env; fill in your values there.

# Security
# Required on write endpoints unless the server is bound to localhost.
# Leave empty: make setup / start / install-claude generate it and copy it to frontend/.env.
CODESAGE_API_KEY=

# Server (defaults to loopback; any other host requires CODESAGE_API_KEY)
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001

# Algolia Configuration - Get from your Algolia dashboard (https://www.algolia.com/)
# App ID and Admin API key: Algolia dashboard > Settings > API Keys
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
# One index per database: records are keyed by repository id, so two databases
# sharing an index (e.g. local and Docker) would delete each other's records
ALGOLIA_INDEX_NAME=codesage_code_entities

# GitHub Configuration - Create a personal access token (https://github.com/settings/tokens)
# Optional; raises the GitHub API rate limit and allows private repos
GITHUB_TOKEN=

# Database Configuration
# SQLite for development (recommended)
DATABASE_URL=sqlite:///./codesage.db
SQL_ECHO=false

# CORS Configuration (comma-separated origins; "*" is rejected)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Extra hostnames the API answers to (besides loopback and the CORS_ORIGINS hosts)
# ALLOWED_HOSTS=

# Environment Settings
ENVIRONMENT=development

# Logging Configuration
LOG_LEVEL=INFO

# Rate limiting (slowapi). Limits are per client IP.
# ENABLE_RATE_LIMITING=true
# RATE_LIMIT_DEFAULT=100/minute
# RATE_LIMIT_AI=30/minute   # MCP tool endpoints

# Who runs indexing jobs. inline (default): the API process. external: the API queues them in
# the database and `python -m app.worker` processes run them; start one or more after the API.
# INDEX_WORKERS=inline

# Semantic search, bring your own key: any OpenAI-compatible embeddings endpoint.
# Off while EMBEDDING_API_KEY is empty. Definitions (name, path and code) are sent to
# this provider when indexing, and queries when searching. Examples:
#   OpenAI:  EMBEDDING_API_URL=https://api.openai.com/v1/embeddings  EMBEDDING_MODEL=text-embedding-3-small
#   Voyage:  EMBEDDING_API_URL=https://api.voyageai.com/v1/embeddings EMBEDDING_MODEL=voyage-code-3
#   Ollama:  EMBEDDING_API_URL=http://localhost:11434/v1/embeddings  EMBEDDING_MODEL=nomic-embed-text  (any key)
# EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small

# Scheduled refresh: every N minutes, re-index the changed files of each completed
# repository whose branch has moved. 0 (the default) turns it off.
# REFRESH_INTERVAL_MINUTES=60

# MCP bridge (codesage_mcp): these are NOT read from this file.
# MCP_SERVER_URL and CODESAGE_MCP_LOG_LEVEL belong in the "env" block of the
# Claude Desktop config; 'make install-claude' writes MCP_SERVER_URL there.

# Frontend Configuration (if running frontend separately)
# VITE_API_BASE_URL=http://localhost:8001/api/v1
