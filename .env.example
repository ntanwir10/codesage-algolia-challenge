# CodeSage environment configuration template.
# 'make setup' copies this to backend/.env; fill in your values there.

# Security
# Required on write endpoints unless the server is bound to localhost.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CODESAGE_API_KEY=

# Server (defaults to loopback; any other host requires CODESAGE_API_KEY)
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8001

# Algolia Configuration - Get from your Algolia dashboard (https://www.algolia.com/)
ALGOLIA_APP_ID=your-algolia-app-id-here
ALGOLIA_ADMIN_API_KEY=your-algolia-admin-api-key-here
# One index per database: records are keyed by repository id, so two databases
# sharing an index (e.g. local and Docker) would delete each other's records
ALGOLIA_INDEX_NAME=codesage_code_entities

# GitHub Configuration - Create a personal access token (https://github.com/settings/tokens)
GITHUB_TOKEN=your-github-personal-access-token-here

# Database Configuration
# SQLite for development (recommended)
DATABASE_URL=sqlite:///./codesage.db
SQL_ECHO=false

# CORS Configuration (comma-separated origins; "*" is rejected)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Extra hostnames the API answers to (besides loopback and the CORS_ORIGINS hosts)
# ALLOWED_HOSTS=

# Environment Settings
ENVIRONMENT=development

# Logging Configuration
LOG_LEVEL=INFO

# Rate limiting (slowapi). Limits are per client IP.
# ENABLE_RATE_LIMITING=true
# RATE_LIMIT_DEFAULT=100/minute
# RATE_LIMIT_AI=30/minute   # MCP tool endpoints

# MCP bridge (codesage_mcp): these are NOT read from this file.
# MCP_SERVER_URL and CODESAGE_MCP_LOG_LEVEL belong in the "env" block of the
# Claude Desktop config; 'make install-claude' writes MCP_SERVER_URL there.

# Frontend settings (VITE_*) go in frontend/.env.local, not here; see frontend/.env.example.
