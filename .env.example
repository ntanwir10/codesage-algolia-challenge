# CodeSage - MCP-First Code Discovery - Environment Configuration Template
# 
# This is the only code discovery tool built entirely around the Model Context Protocol (MCP)
# for seamless AI integration with Claude Desktop and other MCP clients.
# 
# Copy this to .env and fill in your actual values

# Security
SECRET_KEY=your-secret-key-here-change-this-in-production

# Algolia Configuration - Get from your Algolia dashboard (https://www.algolia.com/)
ALGOLIA_APP_ID=your-algolia-app-id-here
ALGOLIA_ADMIN_API_KEY=your-algolia-admin-api-key-here
ALGOLIA_INDEX_NAME=codesage_index

# GitHub Configuration - Create a personal access token (https://github.com/settings/tokens)
GITHUB_TOKEN=your-github-personal-access-token-here

# Database Configuration
# SQLite for development (recommended)
DATABASE_URL=sqlite:///./codesage.db
# PostgreSQL for production
# DATABASE_URL=postgresql://username:password@localhost:5432/codesage

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8001

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment Settings
ENVIRONMENT=development
DEBUG=true

# Logging Configuration
LOG_LEVEL=INFO

# Frontend Configuration (if running frontend separately)
# VITE_API_BASE_URL=http://localhost:8001/api/v1
