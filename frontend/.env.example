# Copy to frontend/.env.local for local development.
# Base URL of the backend API (the default works behind the dev proxy and nginx).
VITE_API_BASE_URL=/api/v1
# Must match CODESAGE_API_KEY in backend/.env. Vite inlines VITE_* values, so
# this ships in the built JavaScript bundle and is visible to anyone who can load the app.
VITE_CODESAGE_API_KEY=
# WebSocket URL. Defaults to same-origin /ws (proxied by Vite and nginx).
# VITE_WS_URL=ws://localhost:8001/ws
