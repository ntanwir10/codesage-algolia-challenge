  "cards": [
    {
      "dot": "cyan",
      "title": "Corrections to the expected shape",
      "items": [
        "The 409 for a running job comes from POST /repositories/{id}/process, not from creating a new row",
        "Algolia settings and the clear step run after the GitHub fetch, so a fetch error never wipes a working index",
        "A run shows processing while it waits for a run slot",
        "Any exception inside the run, including DB errors, ends in Mark failed"
      ]
    },
    {
      "dot": "amber",
      "title": "Batch loop and partial index",
      "items": [
        "A parse failure stores the file with no entities and counts it as unparsed",
        "A failed commit rolls back, counts the batch as failed and moves on",
        "Zero indexed entities fails the run",
        "Skipped, unparsed or failed files add a Partially indexed note to error_message"
      ]
    }
  ]
}