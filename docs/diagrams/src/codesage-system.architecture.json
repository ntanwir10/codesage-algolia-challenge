  "cards": [
    {
      "dot": "cyan",
      "title": "Browser path",
      "items": [
        "SPA sends X-API-Key when VITE_CODESAGE_API_KEY is set, and the key as a codesage.key.<hex> WebSocket subprotocol",
        "Dev: no nginx; SPA reaches the backend directly or through the Vite proxy (/api, /ws to :8001)"
      ]
    },
    {
      "dot": "amber",
      "title": "Prod edge",
      "items": [
        "Port 80 serves only /health and a 301 to HTTPS",
        "nginx overwrites X-API-Key on /api/ and /ws, and overwrites X-Forwarded-For",
        "Basic auth (htpasswd) required except /health; serves the built SPA"
      ]
    },
    {
      "dot": "violet",
      "title": "Claude Desktop path",
      "items": [
        "Bridge adds X-API-Key and optional basic auth; MCP_SERVER_URL may point at nginx in prod",
        "tools/call and resources/read require the API key; slowapi limits apply"
      ]
    },
    {
      "dot": "emerald",
      "title": "Backend guards",
      "items": [
        "BrowserRequestGuard refuses cross-origin writes and WS handshakes; with no key set only loopback clients are served",
        "require_api_key guards writes, performance, tools/call, resources/read and suggestions",
        "Indexing: at most 2 runs at once, one per repository; GitHub and Algolia calls are outbound HTTPS"
      ]
    }
  ]
}