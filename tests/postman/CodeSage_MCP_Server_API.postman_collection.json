{
  "info": {
    "name": "CodeSage MCP Server API",
    "description": "Complete MCP-first API for the Algolia MCP Server Challenge - ALL implemented endpoints including repository management, processing, upload, status, and MCP protocol",
    "version": "2.1.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Check system health including database and Algolia connectivity"
      }
    },
    {
      "name": "Repository Management",
      "item": [
        {
          "name": "List Repositories",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/repositories?skip=0&limit=100&language=python&status=completed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "repositories"],
              "query": [
                {
                  "key": "skip",
                  "value": "0",
                  "description": "Number of repositories to skip"
                },
                {
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum repositories to return (le=500)"
                },
                {
                  "key": "language",
                  "value": "python",
                  "description": "Filter by programming language"
                },
                {
                  "key": "status",
                  "value": "completed",
                  "description": "Filter by processing status"
                }
              ]
            },
            "description": "List all repositories with optional filtering"
          }
        },
        {
          "name": "Create Repository",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"react\",\n  \"description\": \"React JavaScript library for building user interfaces\",\n  \"url\": \"https://github.com/facebook/react\",\n  \"language\": \"javascript\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/repositories/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "repositories", ""]
            },
            "description": "Create repository for GitHub → Algolia processing pipeline"
          }
        },
        {
          "name": "Get Repository",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/repositories/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "repositories", "1"]
            },
            "description": "Get specific repository details and processing status"
          }
        },
        {
          "name": "Delete Repository",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/repositories/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "repositories", "1"]
            },
            "description": "Delete repository and remove from Algolia index"
          }
        },
        {
          "name": "Process Repository",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/repositories/1/process?force_reprocess=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "repositories", "1", "process"],
              "query": [
                {
                  "key": "force_reprocess",
                  "value": "false",
                  "description": "Force reprocessing even if already completed"
                }
              ]
            },
            "description": "Process repository to extract code entities and index in Algolia"
          }
        },
        {
          "name": "Upload Files to Repository",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": [],
                  "description": "Code files to upload for analysis"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/repositories/1/upload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "repositories", "1", "upload"]
            },
            "description": "Upload code files to a repository for analysis"
          }
        },
        {
          "name": "Get Repository Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/repositories/1/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "repositories", "1", "status"]
            },
            "description": "Get the current processing status of a repository"
          }
        },
        {
          "name": "Get Repository Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/repositories/1/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "repositories", "1", "stats"]
            },
            "description": "Get processing statistics for a repository"
          }
        }
      ],
      "description": "Repository CRUD operations for GitHub → Algolia processing"
    },
    {
      "name": "MCP Protocol",
      "item": [
        {
          "name": "Get MCP Server Information",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/mcp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "mcp"]
            },
            "description": "Get MCP server information and available endpoints overview"
          }
        },
        {
          "name": "Get MCP Capabilities",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/mcp/capabilities",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "mcp", "capabilities"]
            },
            "description": "Returns MCP server capabilities for Claude Desktop integration"
          }
        },
        {
          "name": "List MCP Tools",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/mcp/tools",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "mcp", "tools"]
            },
            "description": "List all MCP tools: search_code, analyze_repository, explore_functions, explain_code, find_patterns"
          }
        },
        {
          "name": "Execute MCP Tool - Search Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tool_name\": \"search_code\",\n  \"arguments\": {\n    \"query\": \"React hooks useState\",\n    \"repository\": \"react\",\n    \"language\": \"javascript\",\n    \"entity_type\": \"function\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/mcp/tools/call",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "mcp", "tools", "call"]
            },
            "description": "Natural language code search across indexed repositories"
          }
        },
        {
          "name": "Execute MCP Tool - Analyze Repository",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tool_name\": \"analyze_repository\",\n  \"arguments\": {\n    \"repository_id\": \"1\",\n    \"analysis_type\": \"overview\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/mcp/tools/call",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "mcp", "tools", "call"]
            },
            "description": "Repository analysis and insights through MCP protocol"
          }
        },
        {
          "name": "Execute MCP Tool - Explore Functions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tool_name\": \"explore_functions\",\n  \"arguments\": {\n    \"entity_name\": \"useState\",\n    \"repository\": \"react\",\n    \"similarity_search\": true\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/mcp/tools/call",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "mcp", "tools", "call"]
            },
            "description": "Function discovery and relationship mapping"
          }
        },
        {
          "name": "Execute MCP Tool - Explain Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tool_name\": \"explain_code\",\n  \"arguments\": {\n    \"code_snippet\": \"function useState(initialState) {\\n  return [state, setState];\\n}\",\n    \"context\": \"React hooks implementation\",\n    \"detail_level\": \"detailed\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/mcp/tools/call",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "mcp", "tools", "call"]
            },
            "description": "Code explanation and documentation through MCP"
          }
        },
        {
          "name": "Execute MCP Tool - Find Patterns",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tool_name\": \"find_patterns\",\n  \"arguments\": {\n    \"repository_id\": \"1\",\n    \"pattern_type\": \"security\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/mcp/tools/call",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "mcp", "tools", "call"]
            },
            "description": "Pattern detection across codebase (security, performance, architecture)"
          }
        },
        {
          "name": "Read MCP Resource",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/ai/mcp/resources/read?uri=codesage://repositories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "ai", "mcp", "resources", "read"],
              "query": [
                {
                  "key": "uri",
                  "value": "codesage://repositories",
                  "description": "Resource URI (codesage://repositories, codesage://files?repository_id=1)"
                }
              ]
            },
            "description": "Read MCP resource for AI model context"
          }
        }
      ],
      "description": "Core MCP protocol endpoints for Claude Desktop integration"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set timestamp for requests",
          "pm.globals.set('timestamp', Date.now());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Response validation for clean MCP-first API",
          "pm.test('Status code is successful', function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
          "});",
          "",
          "pm.test('Response time under 2000ms', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});",
          "",
          "pm.test('Content-Type is JSON', function () {",
          "    if (pm.response.headers.get('Content-Type')) {",
          "        pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "    }",
          "});"
        ]
      }
    }
  ]
}
